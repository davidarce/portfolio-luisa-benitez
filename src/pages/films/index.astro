---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Grid from "../../components/Grid.astro";
import Card from "../../components/Card.astro";
import { sortProjects } from "../../lib/sort-projects";

const films = sortProjects(await getCollection("films"));
---

<BaseLayout
    title="Cine | Luisa Benítez"
    description="Cine estilado por Luisa Benítez"
>
    <div class="stack gap-20 lg:gap-48">
        <main class="wrapper stack gap-20 lg:gap-48">
            <Grid variant="small">
                {
                    films.map((film) => (
                        <li>
                            <Card
                                id={film.id}
                                page="films"
                                title={film.data.title}
                                img={film.data.img}
                                img_alt={film.data.img_alt}
                                cardSize={film.data.cardSize}
                                aspectRatio={film.data.aspectRatio}
                                objectPosition={film.data.objectPosition}
                            />
                        </li>
                    ))
                }
            </Grid>
        </main>
    </div>
</BaseLayout>
