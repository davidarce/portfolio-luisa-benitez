---
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import Grid from "../../components/Grid.astro";
import Card from "../../components/Card.astro";
import { sortProjects } from "../../lib/sort-projects";

const runway = sortProjects(await getCollection("runway"));
---

<BaseLayout
    title="Runway | Luisa Benítez"
    description="Runway asistida por Luisa Benítez"
>
    <div class="stack gap-20 lg:gap-48 px-10">
        <main class="stack gap-20 lg:gap-48">
            <Grid variant="small">
                {
                    runway.map((campaign) => {
                        const { id, data } = campaign;
                        const {
                            title,
                            img,
                            img_alt,
                            video,
                            cardSize,
                            aspectRatio,
                            objectPosition,
                            hasGallery,
                        } = data;

                        return (
                            <li>
                                <Card
                                    id={id}
                                    page="runway"
                                    title={title}
                                    img={img}
                                    img_alt={img_alt}
                                    video={video}
                                    cardSize={cardSize}
                                    aspectRatio={aspectRatio}
                                    objectPosition={objectPosition}
                                    disableLink={!hasGallery}
                                />
                            </li>
                        );
                    })
                }
            </Grid>
        </main>
    </div>
</BaseLayout>
