---
// Redirección estática de las 4 fichas retiradas de /work/ (colección
// plantilla, lorem ipsum) — ver plan/02-information-architecture/REVISION-v2.md
// §3 y .sdd/phase2-projects/plan.md T003-T004. Los 4 proyectos ya existen en
// las colecciones reales, así que cada ficha redirige a su equivalente real
// (no a la home). A diferencia del rename de /publicity/ y /celebrities/, el
// destino no se puede derivar del `getStaticPaths` de una sola colección
// nueva — cada slug apunta a una colección distinta — así que el mapeo es
// explícito.
import RedirectPage from "../../components/RedirectPage.astro";

// El objeto de mapeo vive DENTRO de `getStaticPaths`: Astro extrae esta
// función a su propio módulo en build estático y no arrastra `const`s
// definidas fuera de ella (se rompe con "redirects is not defined").
export function getStaticPaths() {
	const redirects: Record<string, { to: string; title: string }> = {
		aitana: { to: "/campaigns/ysl-aitana/", title: "YSL - Aitana" },
		"zara-larsson": {
			to: "/campaigns/prime-video-zara-larsson/",
			title: "Prime Video - Zara Larsson",
		},
		"editorial-vogue": { to: "/editorials/vogue/", title: "Vogue Adria" },
		"miguel-herran": {
			to: "/editorials/miguel-herran/",
			title: "Numéro - Miguel Herrán",
		},
	};

	return Object.entries(redirects).map(([slug, props]) => ({
		params: { slug },
		props,
	}));
}

const { to, title } = Astro.props;
---

<RedirectPage to={to} title={`${title} — Luisa Benítez`} />
