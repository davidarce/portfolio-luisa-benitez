---
// Redirección estática: /contact/ → /#contacto (home unificada, T004). El
// contenido de esta página vive ahora en la sección "Contacto" de
// src/pages/index.astro; ver src/components/RedirectPage.astro para la
// limitación de GitHub Pages (sin 301 real) y por qué es meta-refresh +
// canonical en vez de la opción `redirects` de astro.config.mjs. El título
// reutiliza t.nav.contact — misma razón que en about.astro (T005).
import RedirectPage from "../components/RedirectPage.astro";
import { profile } from "../data/profile";
import { getLocaleFromUrl, getTranslation } from "../i18n";

const t = getTranslation(getLocaleFromUrl(Astro.url));
---

<RedirectPage
	to="/#contacto"
	title={`${t.nav.contact} — ${profile.name}`}
/>
