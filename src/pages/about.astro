---
import { Image } from "astro:assets";
import portrait from "../assets/portrait.webp";

import BaseLayout from "../layouts/BaseLayout.astro";
import CvDownloadLink from "../components/CvDownloadLink.astro";
import { profile } from "../data/profile";
import { about } from "../data/about";

const baseValue = `${profile.baseCity}, ${profile.baseRegion}`;
const languagesValue = profile.languages.join(", ");

/** Tres pares fijos + "Disponibilidad" solo si el dato existe (ver plan.md C3). */
const details: { label: string; value: string }[] = [
	{ label: about.details.base, value: baseValue },
	{ label: about.details.languages, value: languagesValue },
];

if (profile.availableForTravel) {
	details.push({
		label: about.details.availability,
		value: about.travelNote,
	});
}
---

<BaseLayout
	title={about.title}
	description={about.metaDescription}
	path="/about/"
>
	<main class="about">
		<div class="portrait">
			<Image
				src={portrait}
				alt={about.portraitAlt}
				widths={[600, 900, 1200]}
				sizes="(min-width: 50em) 34rem, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<div class="panel">
			<p class="eyebrow">{about.eyebrow}</p>
			<h1 class="headline">{profile.name}</h1>

			<div class="bio">
				{about.bio.map((paragraph) => <p>{paragraph}</p>)}
			</div>

			<section class="rule">
				<h2 class="section-label">{about.sections.services}</h2>
				<ul class="services" role="list">
					{profile.services.map((service) => <li>{service}</li>)}
				</ul>
			</section>

			<section class="rule">
				<h2 class="section-label">{about.sections.featuredIn}</h2>
				<ul class="wordmarks" role="list">
					{profile.featuredIn.map((outlet) => <li>{outlet}</li>)}
				</ul>
			</section>

			<dl class="details rule">
				{
					details.map(({ label, value }) => (
						<div>
							<dt class="detail-label">{label}</dt>
							<dd class="detail-value">{value}</dd>
						</div>
					))
				}
			</dl>

			<div class="ctas">
				<CvDownloadLink />
				<a class="cv" href="/contact/">
					{about.cta.contact}{" "}
					<span class="arrow" aria-hidden="true">&rarr;</span>
				</a>
				<a
					class="cv"
					href={profile.instagram.url}
					target="_blank"
					rel="noopener noreferrer"
				>
					{about.cta.instagram}
					<span class="sr-only"> (se abre en una pestaña nueva)</span>{" "}
					<span class="arrow" aria-hidden="true">&rarr;</span>
				</a>
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	.about {
		display: flex;
		flex-direction: column;
	}

	/* El retrato va a sangre, idéntico al tratamiento móvil de /contact. */
	.portrait {
		position: relative;
		overflow: hidden;
	}

	.portrait :global(img) {
		display: block;
		width: 100%;
		height: 38vh;
		height: 38svh;
		min-height: 16rem;
		max-height: 26rem;
		object-fit: cover;
		object-position: 50% 22%;
		-webkit-mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 70%,
			transparent 100%
		);
		mask-image: linear-gradient(
			to bottom,
			#000 0%,
			#000 70%,
			transparent 100%
		);
	}

	.panel {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		padding: 0.5rem 1.5rem 3rem;
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-base);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.headline {
		font-family: var(--font-brand);
		font-weight: 400;
		font-size: clamp(3.5rem, 15vw, 8rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bio p {
		font-size: var(--text-md);
		line-height: 1.75;
		color: var(--gray-50);
	}

	/* Sustituye al <hr>: el filete pasa a border-top del bloque siguiente. */
	.rule {
		border-top: 1px solid var(--gray-700);
		padding-block-start: 2rem;
		margin-block-start: 2rem;
	}

	.section-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
		margin-bottom: 1rem;
	}

	.services {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.services li {
		font-size: var(--text-md);
		line-height: 1.5;
		color: var(--gray-50);
	}

	/* Wordmarks: sin logos (#12), en la tipografía de marca. Una columna en
	   móvil; a partir de 50em pasa a dos, igual que .details de /contact. */
	.wordmarks {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.wordmarks li {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.details {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
	}

	.details div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.detail-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.detail-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	.ctas {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	/* Área táctil ≥44px (C4). El :global() no es opcional: sin él el padding
	   no alcanza al <a> que vive dentro de <CvDownloadLink />. */
	.ctas > :global(a) {
		padding-block: 0.5rem;
	}

	/*
	 * Ámbito de Astro: estas reglas NO cruzan el límite del componente, así que
	 * no llegan al <a> de CvDownloadLink.astro. Se redeclaran aquí, verbatim,
	 * para los CTAs de Contacto e Instagram (plan.md, Contract Specifications C4).
	 */
	.cv {
		display: inline-flex;
		align-items: baseline;
		align-self: flex-start;
		gap: 0.5rem;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-0);
		text-decoration: none;
		transition: color var(--theme-transition);
	}

	.cv .arrow {
		display: inline-block;
		transition: transform var(--theme-transition);
	}

	.cv:hover,
	.cv:focus-visible {
		color: var(--link-color);
	}

	.cv:hover .arrow,
	.cv:focus-visible .arrow {
		transform: translateX(0.3rem);
	}

	/*
	 * Anillo de foco propio y tokenizado (C4): el único cue de foco de .cv era
	 * el cambio de color, y en tema claro --link-color contra --gray-0 da
	 * 1,12:1 (indistinguible). --gray-0 sobre --gray-999 es el máximo
	 * contraste posible en ambos temas y se invierte solo con el tema; no se
	 * toca --link-color.
	 */
	a:focus-visible {
		outline: 2px solid var(--gray-0);
		outline-offset: 3px;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.cv,
		.cv .arrow {
			transition: none;
		}
	}

	/* Único breakpoint del sistema de diseño. No replica la rejilla de dos
	   columnas de /contact: aquella cabe en un viewport, esta scrollea. */
	@media (min-width: 50em) {
		.panel {
			margin-inline: auto;
			max-width: 34rem;
			padding: 1rem 1.5rem 5rem;
		}

		.portrait :global(img) {
			height: 60svh;
			max-height: 34rem;
		}

		.bio p {
			font-size: var(--text-lg);
			line-height: 1.7;
			max-width: 32rem;
		}

		.details,
		.wordmarks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.ctas {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 2rem;
		}

		.eyebrow,
		.section-label,
		.detail-label {
			font-size: var(--text-base);
		}

		.detail-value {
			font-size: var(--text-md);
		}
	}
</style>
