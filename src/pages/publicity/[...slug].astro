---
// Redirección estática de las 11 fichas de detalle: /publicity/<slug> →
// /campaigns/<slug> (rename Fase 2 §4). Reutiliza el `getStaticPaths` de la
// colección "campaigns" para generar exactamente un stub de redirección por
// cada ficha existente, sin mantener una lista de slugs a mano. Ver
// src/components/RedirectPage.astro para por qué es meta-refresh + canonical
// y no un `redirects` de astro.config.mjs (no soporta rutas dinámicas de
// colección en modo static).
import { getCollection } from "astro:content";
import RedirectPage from "../../components/RedirectPage.astro";

export async function getStaticPaths() {
    const campaigns = await getCollection("campaigns");
    return campaigns.map((entry) => ({
        params: { slug: entry.id },
        props: { to: `/campaigns/${entry.id}/`, title: entry.data.title },
    }));
}

const { to, title } = Astro.props;
---

<RedirectPage to={to} title={`${title} — Luisa Benítez`} />
