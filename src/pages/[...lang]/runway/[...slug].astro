---
import { type CollectionEntry, getCollection } from "astro:content";

import ContactCTA from "../../../components/ContactCTA.astro";
import CreditsBlock from "../../../components/CreditsBlock.astro";
import Hero from "../../../components/Hero.astro";
import Icon from "../../../components/Icon.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Grid from "../../../components/Grid.astro";
import { getTranslation } from "../../../i18n";
import { collectionLocalePaths, localizedPath } from "../../../i18n/routing";

interface Props {
    entry: CollectionEntry<"runway">;
    locale: import("../../../i18n").Locale;
}

export async function getStaticPaths() {
    const runway = await getCollection("runway");
    return collectionLocalePaths(runway);
}

const { entry, locale } = Astro.props;
const t = getTranslation(locale);
const description = entry.data.descriptionEn ?? entry.data.description;
const descriptionIsSpanish = locale === "en" && !entry.data.descriptionEn;
---

<BaseLayout
    title={`${entry.data.title} | Luisa Benítez`}
    description={description ?? entry.data.title}
    image={`/assets/og/runway/${entry.id}.jpg`}
    imageAlt={entry.data.img_alt ?? entry.data.title}
>
    <div class="stack gap-20">
        <div class="stack gap-15">
            <header>
                <div class="wrapper stack gap-2">
                    <a class="back-link" href={localizedPath(locale, "/runway")}
                        ><Icon icon="arrow-left" /> {t.common.back}</a
                    >
                    <Hero title={entry.data.title} align="start">
                        <div class="details">
                            <p class="description" lang={descriptionIsSpanish ? "es" : undefined}>{description}</p>
                        </div>
                    </Hero>
                </div>
            </header>
            <main class="wrapper">
                <div class="stack gap-10">
                    <CreditsBlock
                        role={entry.data.role}
                        roleDetail={entry.data.roleDetail}
                        leadStylist={entry.data.leadStylist}
                        year={entry.data.year}
                        client={entry.data.client}
                        publication={entry.data.publication}
                        format={entry.data.format}
                        credits={entry.data.credits}
                    />
                    <Grid variant="small">
                        {
                            entry.data.images.map((img) => {
                                const isVideo = /\.(mp4|webm|mov)$/i.test(img);
                                return (
                                    <li class="gallery-item">
                                        {isVideo ? (
                                            <video
                                                src={img}
                                                poster={img.replace(
                                                    /\/([^/]+)\.(mp4|webm|mov)$/i,
                                                    "/posters/$1.webp",
                                                )}
                                                loop
                                                muted
                                                playsinline
                                                controls
                                                preload="none"
                                            />
                                        ) : (
                                            <img
                                                src={img}
                                                alt={`${entry.data.title}`}
                                                loading="lazy"
                                            />
                                        )}
                                    </li>
                                );
                            })
                        }
                    </Grid>
                </div>
            </main>
        </div>
        <ContactCTA />
    </div>
</BaseLayout>

<script>
	// Mismo patrón que Card.astro (P1): preload="none" + reproducción solo en viewport.
	document.addEventListener("astro:page-load", () => {
		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		if (prefersReducedMotion) return;

		document
			.querySelectorAll<HTMLVideoElement>(".gallery-item video")
			.forEach((video) => {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								// play() puede rechazar (p. ej. si el usuario navega antes de que arranque).
								video.play().catch(() => {});
							} else {
								video.pause();
							}
						}
					},
					{ threshold: 0.25 },
				);
				observer.observe(video);
			});
	});
</script>

<style>
    header {
        padding-bottom: 2.5rem;
        border-bottom: 1px solid var(--gray-800);
    }

    .back-link {
        display: block;
        color: var(--gray-0);
        text-decoration: none;
    }

    .details {
        display: flex;
        flex-direction: column;
        padding: 0.5rem;
        gap: 1.5rem;
        justify-content: space-between;
        align-items: center;
    }

    .tags {
        display: flex;
        gap: 0.5rem;
    }

    .description {
        font-size: var(--text-lg);
        max-width: 80ch;
    }

    .content {
        max-width: 100ch;
        margin-inline: auto;
    }

    .content > :global(* + *) {
        margin-top: 1rem;
    }

    .content :global(h1),
    .content :global(h2),
    .content :global(h3),
    .content :global(h4),
    .content :global(h5) {
        margin: 1.5rem 0;
    }

    .content :global(img) {
        border-radius: 1.5rem;
        box-shadow: var(--shadow-sm);
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
    }

    /* aspect-ratio reserva la altura del ítem antes de que la imagen (o vídeo)
       cargue. Ver editorials/[...slug].astro para el diagnóstico completo del
       bug de lazy-loading que arregla. */
    .gallery-item {
        overflow: hidden;
        border-radius: 1.5rem;
        aspect-ratio: 3 / 4;
    }

    .gallery-item img,
    .gallery-item video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 1.5rem;
        box-shadow: var(--shadow-sm);
        background: var(--gradient-subtle);
        border: 1px solid var(--gray-800);
        transition: transform var(--theme-transition);
    }

    .gallery-item img:hover,
    .gallery-item video:hover {
        transform: scale(1.02);
    }

    .back-link {
        text-decoration: 1px solid underline transparent;
        text-underline-offset: 0.25em;
        transition: text-decoration-color var(--theme-transition);
    }

    .back-link:hover,
    .back-link:focus {
        text-decoration-color: currentColor;
    }

    @media (min-width: 50em) {
        .back-link {
            display: block;
            align-self: flex-start;
        }

        .details {
            flex-direction: row;
            gap: 2.5rem;
        }
    }
</style>
