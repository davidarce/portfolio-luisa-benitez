---
import { getCollection } from "astro:content";

import BaseLayout from "../../../layouts/BaseLayout.astro";
import Grid from "../../../components/Grid.astro";
import Card from "../../../components/Card.astro";
import Hero from "../../../components/Hero.astro";
import { getTranslation } from "../../../i18n";
import { localeStaticPaths } from "../../../i18n/routing";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getTranslation(locale);

const campaigns = await getCollection("campaigns");
---

<BaseLayout
    title={t.collections.campaigns.title}
    description={t.collections.campaigns.description}
>
    <div class="stack gap-20 lg:gap-20">
        <header class="wrapper">
        	<Hero title={t.collections.campaigns.heading} align="start" />
        </header>
        <main id="contenido" class="wrapper stack gap-20 lg:gap-48">
            <Grid variant="small">
                {
                    campaigns.map((campaign, i) => {
                        const { id, data } = campaign;
                        const {
                            title,
                            img,
                            img_alt,
                            cardSize,
                            aspectRatio,
                            objectPosition,
                            hasGallery,
                        } = data;

                        return (
                            <li>
                                <Card
                                    id={id}
                                    page="campaigns"
                                    title={title}
                                    img={img}
                                    img_alt={img_alt}
                                    cardSize={cardSize}
                                    aspectRatio={aspectRatio}
                                    objectPosition={objectPosition}
                                    disableLink={!hasGallery}
                                    priority={i === 0}
                                />
                            </li>
                        );
                    })
                }
            </Grid>
        </main>
    </div>
</BaseLayout>
