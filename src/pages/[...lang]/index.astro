---
import { getCollection } from "astro:content";

import { Image } from "astro:assets";
import heroFoto from "../../assets/hero/ia-set-tul.webp";

import Grid from "../../components/Grid.astro";
import Icon from "../../components/Icon.astro";
import Card from "../../components/Card.astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { getTranslation } from "../../i18n";
import { localeStaticPaths } from "../../i18n/routing";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getTranslation(locale);


// La colección "work" (plantilla de Astro) se retiró: la home combina ahora los 5 listados reales.
const featuredCollections = [
	"editorials",
	"campaigns",
	"celebrity-events",
	"runway",
	"films",
] as const;

const porColeccion = await Promise.all(
	featuredCollections.map((collection) => getCollection(collection)),
);

// Mandan los que Luisa marca como destacados. El resto se rellena tomando uno
// de cada sección por turnos: cogiendo los primeros de la lista saldrían cuatro
// editoriales seguidas, y la portada del sitio es justo donde conviene enseñar
// que hace cosas distintas.
const marcados = porColeccion.flat().filter((p) => p.data.featured);
const porTurnos = [];
for (let i = 0; porTurnos.length < 4; i++) {
	const fila = porColeccion.map((c) => c.filter((p) => !p.data.featured)[i]).filter(Boolean);
	if (!fila.length) break;
	porTurnos.push(...fila);
}
const featuredProjects = [...marcados, ...porTurnos].slice(0, 4);

// La sección de contacto vive solo en contact.astro: aquí no se repiten canales ni datos.

/** Dos pares fijos + "Disponibilidad" si el dato existe, y el correo al final. */
const aboutDetails: { label: string; value: string; href?: string }[] = [
	{ label: t.details.base, value: `${profile.baseCity}, ${t.profile.country}` },
	{ label: t.details.languages, value: t.profile.languages.join(", ") },
];

if (profile.availableForTravel) {
	aboutDetails.push({
		label: t.details.availability,
		value: t.profile.travelNote,
	});
}

// El correo cierra el bloque: decir «disponible para viajar» y no decir cómo se
// le escribe dejaba a medias a quien baja la home entera (6,7 pantallas en
// móvil) y no encuentra ni un enlace de contacto en todo el contenido.
aboutDetails.push({
	label: t.channels.email,
	value: profile.email,
	href: `mailto:${profile.email}`,
});
---

<BaseLayout
	title={t.meta.siteTitle}
	description={t.meta.siteDescription}
>
	<div class="stack gap-20">
		<section class="portada">
			<Image
				src={heroFoto}
				alt={t.home.heroAlt}
				widths={[900, 1400, 2048]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>

			<div class="portada-texto wrapper">
				<p class="eyebrow">{profile.role}</p>
				<h1 class="headline">{profile.name}</h1>
				<p class="tagline">{t.home.tagline}</p>
				<a
					href={profile.instagram.url}
					target="_blank"
					rel="noopener noreferrer"
					class="instagram-link"
				>
					<Icon icon="instagram-logo" size="1.5em" />
					{profile.instagram.handle}
					<span class="sr-only"> {t.common.newWindowHint}</span>
				</a>
			</div>
		</section>

		<main id="contenido" class="wrapper stack gap-20">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>{t.home.featuredWorkTitle}</h2>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							featuredProjects.map((project) => {
								const { id, collection, data } = project;
								const {
									title,
									img,
									img_alt,
									cardSize,
									aspectRatio,
									objectPosition,
									hasGallery,
								} = data;

								return (
									<li>
										<Card
											id={id}
											page={collection}
											title={title}
											img={img}
											img_alt={img_alt}
											cardSize={cardSize}
											aspectRatio={aspectRatio}
											objectPosition={objectPosition}
											disableLink={!hasGallery}
										/>
									</li>
								);
							})
						}
					</Grid>
				</div>
			</section>
			<section id="sobre-mi" class="about">
				<div class="about-grid">
					<div class="about-content">
						<h2 class="section-heading">{t.about.eyebrow}</h2>

						<div class="bio">
							{t.about.bio.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					</div>

					<aside class="about-aside">
						<section class="rule">
							<h3 class="section-label">{t.about.sections.services}</h3>
							<ul class="services" role="list">
								{t.profile.services.map((service) => <li>{service}</li>)}
							</ul>
						</section>

						<section class="rule">
							<h3 class="section-label">{t.about.sections.featuredIn}</h3>
							<ul class="wordmarks" role="list">
								{profile.featuredIn.map((outlet) => <li>{outlet}</li>)}
							</ul>
						</section>

						<dl class="details rule">
							{
								aboutDetails.map(({ label, value, href }) => (
									<div>
										<dt class="detail-label">{label}</dt>
										<dd class="detail-value">
											{href ? <a href={href}>{value}</a> : value}
										</dd>
									</div>
								))
							}
						</dl>
					</aside>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	/*
	 * Portada a sangre con una sola foto del set. En móvil el hueco es más alto
	 * que ancho: ahí se recorta a 6:5, la proporción más estrecha donde caben la
	 * modelo y Luisa (medido: deja ver el 68% del ancho y hacen falta el 63%), y
	 * el texto baja debajo. En escritorio la foto ocupa la franja entera y el
	 * texto va oscuro sobre el ciclorama, sin velo que ensucie la imagen.
	 */
	.portada {
		position: relative;
		display: grid;
	}

	.portada :global(picture),
	.portada > :global(img) {
		aspect-ratio: 6 / 5;
	}

	.portada :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 62% 50%;
		aspect-ratio: 6 / 5;
	}

	.portada-texto {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		padding-block: 1.75rem 0;
		min-width: 0;
	}

	.portada-texto .eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-base);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.portada-texto .headline {
		font-family: var(--font-brand);
		font-weight: 400;
		font-size: clamp(3rem, 13vw, 6rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--gray-0);
		max-width: 8ch;
	}

	.portada-texto .tagline {
		max-width: 34ch;
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--gray-50);
	}

	.instagram-link {
		display: flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.5rem;
		color: var(--gray-0);
		text-decoration: none;
		font-weight: 500;
		font-size: var(--text-md);
		transition: color var(--theme-transition);
	}

	.instagram-link:hover {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.portada {
			aspect-ratio: 2.36 / 1;
			overflow: hidden;
		}

		/*
		 * Velo claro solo por la izquierda. El contraste del nombre ya era de
		 * 10:1, pero el fondo variaba 137 puntos de claro a oscuro bajo el texto
		 * (ciclorama y tul alternándose) y eso es lo que cansa la vista. Aclara
		 * en vez de oscurecer porque el texto es oscuro, y se desvanece antes de
		 * llegar a la modelo para no tocar la foto.
		 */
		.portada::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				to right,
				rgb(236 236 233 / 0.82) 0%,
				rgb(236 236 233 / 0.62) 22%,
				rgb(236 236 233 / 0) 42%
			);
		}

		.portada :global(img) {
			position: absolute;
			inset: 0;
			aspect-ratio: auto;
			object-position: 50% 50%;
		}

		.portada-texto,
		.portada-texto .eyebrow,
		.portada-texto .headline,
		.portada-texto .tagline,
		.portada-texto .instagram-link {
			color: #14161f;
		}

		.portada-texto {
			position: relative;
			z-index: 1;
			height: 100%;
			justify-content: center;
			padding-block: 0;
			gap: 1.25rem;
			/*
			 * Se sale del contenedor centrado del sitio y se pega al borde: dentro
			 * del wrapper el texto caía sobre la cola del vestido, que es donde se
			 * perdía. Aquí manda la foto, no la retícula.
			 */
			max-width: none;
			margin-inline: 0;
			padding-inline: clamp(1.5rem, 4vw, 4.5rem);
		}

		.portada-texto .tagline {
			max-width: 24ch;
			font-size: var(--text-base);
		}
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: "";
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 100ch;
		font-size: var(--text-md);
		color: var(--gray-0);
	}

	.section-header h2 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: "header header header header" "gallery gallery gallery gallery";
			gap: 5rem;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h2 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}
	}

	/*
	 * La rejilla ocupa siempre el ancho completo: lo que cambia con la pantalla
	 * es el número de columnas, no el margen. Medido, no estimado: con dos
	 * columnas fijas la tarjeta llegaba a 880px de alto en un portátil (98% de
	 * la pantalla) y a 1018px a 768px de ancho, más alta que el propio viewport.
	 */
	@media (min-width: 40em) {
		.gallery :global(.grid) {
			grid-template-columns: 1fr 1fr;
			gap: 2rem;
		}
	}

	@media (min-width: 75em) {
		.gallery :global(.grid) {
			grid-template-columns: repeat(4, 1fr);
			gap: 2.5rem;
		}
	}

	/* Alineada a la izquierda, igual que "Trabajos destacados", no centrada. */
	.about {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.about-grid {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		max-width: 42rem;
		min-width: 0;
	}

	.about-aside {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		max-width: 42rem;
		min-width: 0;
	}

	.section-heading {
		font-family: var(--font-brand);
		color: var(--gray-0);
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bio p {
		font-size: var(--text-md);
		line-height: 1.75;
		color: var(--gray-50);
	}

	/* Sustituye al <hr>: el filete pasa a border-top del bloque siguiente. */
	.rule {
		border-top: 1px solid var(--gray-700);
		padding-block-start: 2rem;
	}

	.section-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
		margin-bottom: 1rem;
	}

	.services {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.services li {
		font-size: var(--text-md);
		line-height: 1.5;
		color: var(--gray-50);
	}

	.wordmarks {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.wordmarks li {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.details {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
	}

	.details div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.detail-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.detail-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	/* Subrayado: sin él el correo parecía un dato más y no se veía que se pulsa. */
	.detail-value a {
		color: var(--gray-0);
		text-decoration: underline;
		text-decoration-color: var(--accent-regular);
		text-underline-offset: 0.25em;
		text-decoration-thickness: 1px;
		transition: color var(--theme-transition);
	}

	.detail-value a:hover,
	.detail-value a:focus-visible {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.bio p {
			font-size: var(--text-lg);
			line-height: 1.7;
		}

		.details,
		.wordmarks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.section-label,
		.detail-label {
			font-size: var(--text-base);
		}

		.detail-value {
			font-size: var(--text-md);
		}
	}

	/*
	 * Bio a la izquierda, aside a la derecha en vez de debajo: dejaba un
	 * hueco vacío enorme. 64em es el primer punto donde la fila cabe sin
	 * apretar (976px de .wrapper, 672px de bio + 48px de gap = 256px para
	 * .about-aside), por eso aquí se fuerza `.details`/`.wordmarks` de vuelta
	 * a una sola columna (la regla de 50em las pone a dos, pensada para el
	 * tramo intermedio donde el aside sigue debajo).
	 */
	@media (min-width: 64em) {
		.about-grid {
			flex-direction: row;
			align-items: flex-start;
			gap: 3rem;
		}

		.about-content {
			flex: 0 0 42rem;
			width: auto;
		}

		.about-aside {
			flex: 1;
			width: auto;
			max-width: none;
		}

		.details,
		.wordmarks {
			grid-template-columns: 1fr;
		}
	}

	/* Anillo de foco propio: el único cue previo era el color, y en tema claro daba 1,12:1 (indistinguible). */
	a:focus-visible {
		outline: 2px solid var(--gray-0);
		outline-offset: 3px;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.instagram-link {
			transition: none;
		}
	}
</style>
