---
import { getCollection } from "astro:content";

import { Image } from "astro:assets";
import heroPap from "../../assets/hero/pap-the-new-dandy.webp";
import heroArtego from "../../assets/hero/artego-color-pop-garden.webp";
import heroIsabelArbos from "../../assets/hero/isabel-arbos-model-test.webp";
import heroAitana from "../../assets/hero/aitana-ysl.webp";

import Grid from "../../components/Grid.astro";
import Icon from "../../components/Icon.astro";
import Card from "../../components/Card.astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { profile } from "../../data/profile";
import { sortProjects } from "../../lib/sort-projects";
import { getTranslation } from "../../i18n";
import { localeStaticPaths } from "../../i18n/routing";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getTranslation(locale);

/**
 * Portada: rejilla de 4 fotos reales, elegidas a mano por variedad de color y
 * tipo de encargo (no por nombre de fichero). Se descarta tania-deniz-coachella
 * porque esas fotos llevan un icono de mute quemado en la esquina.
 *
 * Copiadas a src/assets/hero/ (no importadas desde public/) para que pasen
 * por astro:assets: en public/ el mosaico descartado pesaba 632 KB por saltarse el procesado.
 *
 * El nombre y el rol NO se superponen a las fotos (ver <div class="hero-panel">
 * más abajo): así el contraste no depende de la imagen y no hace falta velo.
 */
const heroTiles = [
	{
		src: heroPap,
		alt: "Editorial PAP Magazine — The New Dandy",
		position: "50% 8%",
		// Zoom leve: empuja fuera de encuadre el wordmark "PAP" impreso abajo en la imagen.
		zoom: 1.2,
	},
	{ src: heroArtego, alt: "Editorial Artego — Color Pop Garden", position: "50% 10%", zoom: 1 },
	{ src: heroIsabelArbos, alt: "Model test — Isabel Arbós", position: "50% 15%", zoom: 1 },
	{
		src: heroAitana,
		alt: "Estilismo de evento — Aitana, YSL Beauty",
		position: "50% 15%",
		zoom: 1,
	},
] as const;

// La colección "work" (plantilla de Astro) se retiró: la home combina ahora los 5 listados reales.
const featuredCollections = [
	"editorials",
	"campaigns",
	"celebrity-events",
	"runway",
	"films",
] as const;

const allProjects = (
	await Promise.all(featuredCollections.map((collection) => getCollection(collection)))
).flat();

const featuredProjects = sortProjects(allProjects).slice(0, 4);

// La sección de contacto vive solo en contact.astro: aquí no se repiten canales ni datos.

/** Idéntico a about.astro: dos pares fijos + "Disponibilidad" si el dato existe. */
const aboutDetails: { label: string; value: string }[] = [
	{ label: t.details.base, value: `${profile.baseCity}, ${t.profile.country}` },
	{ label: t.details.languages, value: t.profile.languages.join(", ") },
];

if (profile.availableForTravel) {
	aboutDetails.push({
		label: t.details.availability,
		value: t.profile.travelNote,
	});
}
---

<BaseLayout
	title={t.meta.siteTitle}
	description={t.meta.siteDescription}
>
	<div class="stack gap-20">
		<section class="hero wrapper">
			<div class="hero-grid">
				{
					heroTiles.map((tile) => (
						<div class="hero-tile">
							<Image
								src={tile.src}
								alt={tile.alt}
								widths={[280, 420, 600, 800]}
								sizes="(min-width: 50em) 23vw, 50vw"
								loading="eager"
								fetchpriority="high"
								style={`object-position: ${tile.position}; transform: scale(${tile.zoom});`}
							/>
						</div>
					))
				}
			</div>

			<div class="hero-panel">
				<p class="eyebrow">{profile.role}</p>
				<h1 class="headline">{profile.name}</h1>
				<p class="tagline">{t.home.tagline}</p>
				<a
					href={profile.instagram.url}
					target="_blank"
					rel="noopener noreferrer"
					class="instagram-link"
				>
					<Icon icon="instagram-logo" size="1.5em" />
					{profile.instagram.handle}
					<span class="sr-only"> {t.common.newWindowHint}</span>
				</a>
			</div>
		</section>

		<main id="contenido" class="wrapper stack gap-20">
			<section class="section with-background with-cta">
				<header class="section-header stack gap-2 lg:gap-4">
					<h2>{t.home.featuredWorkTitle}</h2>
				</header>

				<div class="gallery">
					<Grid variant="offset">
						{
							featuredProjects.map((project) => {
								const { id, collection, data } = project;
								const {
									title,
									img,
									img_alt,
									cardSize,
									aspectRatio,
									objectPosition,
									hasGallery,
								} = data;

								return (
									<li>
										<Card
											id={id}
											page={collection}
											title={title}
											img={img}
											img_alt={img_alt}
											cardSize={cardSize}
											aspectRatio={aspectRatio}
											objectPosition={objectPosition}
											disableLink={!hasGallery}
										/>
									</li>
								);
							})
						}
					</Grid>
				</div>
			</section>
			<section id="sobre-mi" class="about">
				<div class="about-grid">
					<div class="about-content">
						<h2 class="section-heading">{t.about.eyebrow}</h2>

						<div class="bio">
							{t.about.bio.map((paragraph) => <p>{paragraph}</p>)}
						</div>
					</div>

					<aside class="about-aside">
						<section class="rule">
							<h3 class="section-label">{t.about.sections.services}</h3>
							<ul class="services" role="list">
								{t.profile.services.map((service) => <li>{service}</li>)}
							</ul>
						</section>

						<section class="rule">
							<h3 class="section-label">{t.about.sections.featuredIn}</h3>
							<ul class="wordmarks" role="list">
								{profile.featuredIn.map((outlet) => <li>{outlet}</li>)}
							</ul>
						</section>

						<dl class="details rule">
							{
								aboutDetails.map(({ label, value }) => (
									<div>
										<dt class="detail-label">{label}</dt>
										<dd class="detail-value">{value}</dd>
									</div>
								))
							}
						</dl>
					</aside>
				</div>
			</section>
		</main>
	</div>
</BaseLayout>

<style>
	.hero {
		display: flex;
		flex-direction: column;
	}

	/* Sin degradado de máscara ni velo: el nombre/rol viven en .hero-panel, aparte de las imágenes. */
	.hero-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		grid-template-rows: repeat(2, 1fr);
		gap: 2px;
		height: 42vh;
		height: 42svh;
		min-height: 18rem;
		max-height: 28rem;
		min-width: 0;
	}

	.hero-tile {
		position: relative;
		overflow: hidden;
	}

	.hero-tile :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-panel {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		padding: 0.5rem 1.5rem 3rem;
		min-width: 0;
	}

	.hero .eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-base);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.hero .headline {
		font-family: var(--font-brand);
		font-weight: 400;
		font-size: clamp(3.5rem, 15vw, 8rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.hero .tagline {
		max-width: 34ch;
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--gray-50);
	}

	.instagram-link {
		display: flex;
		align-items: center;
		align-self: flex-start;
		gap: 0.5rem;
		color: var(--gray-0);
		text-decoration: none;
		font-weight: 500;
		font-size: var(--text-md);
		transition: color var(--theme-transition);
	}

	.instagram-link:hover {
		color: var(--accent-regular);
	}

	@media (min-width: 50em) {
		.hero {
			flex-direction: row;
		}

		.hero-grid {
			/*
			 * Se mantiene la rejilla 2×2 en escritorio (no 4×1): medido, 4
			 * columnas daban lonchas verticales donde no se reconocía nada.
			 * `height` escala con 58vw para mantener la proporción entre
			 * breakpoints; el `clamp` evita que crezca sin límite en pantallas anchas.
			 */
			flex: 5;
			grid-template-columns: repeat(2, 1fr);
			grid-template-rows: repeat(2, 1fr);
			height: clamp(26rem, 58vw, 44rem);
			min-height: 0;
			max-height: none;
		}

		.hero-panel {
			flex: 6;
			justify-content: center;
			gap: 1.75rem;
			padding: 3rem 3rem 3rem 4rem;
		}

		.hero .tagline {
			font-size: var(--text-lg);
		}
	}

	.section {
		display: grid;
		gap: 2rem;
	}

	.with-background {
		position: relative;
	}

	.with-background::before {
		--hero-bg: var(--bg-image-subtle-2);

		content: "";
		position: absolute;
		pointer-events: none;
		left: 50%;
		width: 100vw;
		aspect-ratio: calc(2.25 / var(--bg-scale));
		top: 0;
		transform: translateY(-75%) translateX(-50%);
		background-blend-mode: overlay, normal, normal, normal;
		mix-blend-mode: var(--bg-blend-mode);
		z-index: -1;
	}

	.section-header {
		justify-self: center;
		text-align: center;
		max-width: 100ch;
		font-size: var(--text-md);
		color: var(--gray-0);
	}

	.section-header h2 {
		font-size: var(--text-2xl);
	}

	@media (min-width: 50em) {
		.section {
			grid-template-columns: repeat(4, 1fr);
			grid-template-areas: "header header header header" "gallery gallery gallery gallery";
			gap: 5rem;
		}

		.section-header {
			grid-area: header;
			font-size: var(--text-lg);
		}

		.section-header h2 {
			font-size: var(--text-4xl);
		}

		.with-cta .section-header {
			justify-self: flex-start;
			text-align: left;
		}

		.gallery {
			grid-area: gallery;
		}
	}

	/* Alineada a la izquierda, igual que "Trabajos destacados" y .hero-grid, no centrada. */
	.about {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.about-grid {
		display: flex;
		flex-direction: column;
		gap: 2rem;
	}

	.about-content {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		max-width: 42rem;
		min-width: 0;
	}

	.about-aside {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		width: 100%;
		max-width: 42rem;
		min-width: 0;
	}

	.section-heading {
		font-family: var(--font-brand);
		color: var(--gray-0);
	}

	.bio {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.bio p {
		font-size: var(--text-md);
		line-height: 1.75;
		color: var(--gray-50);
	}

	/* Sustituye al <hr>: el filete pasa a border-top del bloque siguiente. */
	.rule {
		border-top: 1px solid var(--gray-700);
		padding-block-start: 2rem;
	}

	.section-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
		margin-bottom: 1rem;
	}

	.services {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.services li {
		font-size: var(--text-md);
		line-height: 1.5;
		color: var(--gray-50);
	}

	.wordmarks {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.wordmarks li {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.details {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
	}

	.details div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.detail-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.detail-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	@media (min-width: 50em) {
		.bio p {
			font-size: var(--text-lg);
			line-height: 1.7;
		}

		.details,
		.wordmarks {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.section-label,
		.detail-label {
			font-size: var(--text-base);
		}

		.detail-value {
			font-size: var(--text-md);
		}
	}

	/*
	 * Bio a la izquierda, aside a la derecha en vez de debajo: dejaba un
	 * hueco vacío enorme. 64em es el primer punto donde la fila cabe sin
	 * apretar (976px de .wrapper, 672px de bio + 48px de gap = 256px para
	 * .about-aside), por eso aquí se fuerza `.details`/`.wordmarks` de vuelta
	 * a una sola columna (la regla de 50em las pone a dos, pensada para el
	 * tramo intermedio donde el aside sigue debajo).
	 */
	@media (min-width: 64em) {
		.about-grid {
			flex-direction: row;
			align-items: flex-start;
			gap: 3rem;
		}

		.about-content {
			flex: 0 0 42rem;
			width: auto;
		}

		.about-aside {
			flex: 1;
			width: auto;
			max-width: none;
		}

		.details,
		.wordmarks {
			grid-template-columns: 1fr;
		}
	}

	/* Anillo de foco propio: el único cue previo era el color, y en tema claro daba 1,12:1 (indistinguible). */
	a:focus-visible {
		outline: 2px solid var(--gray-0);
		outline-offset: 3px;
		border-radius: 2px;
	}

	@media (prefers-reduced-motion: reduce) {
		.instagram-link {
			transition: none;
		}
	}
</style>
