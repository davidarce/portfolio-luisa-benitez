---
import { type CollectionEntry, getCollection } from "astro:content";

import ProjectDetail from "../../../components/ProjectDetail.astro";
import { collectionLocalePaths } from "../../../i18n/routing";

interface Props {
	entry: CollectionEntry<"celebrity-events">;
	locale: import("../../../i18n").Locale;
}

export async function getStaticPaths() {
	return collectionLocalePaths(await getCollection("celebrity-events"));
}

const { entry, locale } = Astro.props;
---

<ProjectDetail entry={entry} collection="celebrity-events" locale={locale} />
