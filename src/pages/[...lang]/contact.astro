---
// Página propia de contacto (plan-v2.md T004): vuelve a serlo tras la home
// unificada. Diseño recuperado de git (feac143..db2353f, previo a c25cfb5,
// donde /contact pasó a ser redirección) porque ya estaba validado por David
// tras varias iteraciones — ver comentarios de .portrait/.panel abajo, que
// documentan los desbordes concretos que arreglaron. La sección "Contacto"
// sale de index.astro (T004) para no duplicar canales/datos en dos sitios.
import { Image } from "astro:assets";
import portrait from "../../assets/portrait.webp";

import BaseLayout from "../../layouts/BaseLayout.astro";
import CvDownloadLink from "../../components/CvDownloadLink.astro";
import { profile } from "../../data/profile";
import { getTranslation } from "../../i18n";
import { localeStaticPaths } from "../../i18n/routing";

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props;
const t = getTranslation(locale);

/** Los canales son las vías de contacto: mismo bloque, misma jerarquía. */
const channels: { label: string; value: string; href: string; external?: boolean }[] = [
	{
		label: t.channels.email,
		value: profile.email,
		href: `mailto:${profile.email}`,
	},
	{
		label: t.channels.instagram,
		value: profile.instagram.handle,
		href: profile.instagram.url,
		external: true,
	},
];

if (profile.linkedin) {
	channels.push({
		label: t.channels.linkedin,
		value: t.channels.linkedinValue,
		href: profile.linkedin,
		external: true,
	});
}

/**
 * Sin "disponibilidad" a propósito: es un estado que cambia y este sitio es
 * estático, así que quedaría desactualizado sin que nadie se dé cuenta. Además
 * anunciar disponibilidad en un portfolio se lee a menudo como "sin trabajo".
 * `profile.availableForTravel` sigue existiendo por si /about lo necesita.
 */
const details: { label: string; value: string }[] = [
	{ label: t.details.base, value: `${profile.baseCity}, ${t.profile.country}` },
	{ label: t.details.languages, value: t.profile.languages.join(", ") },
];
---

<BaseLayout
	title={t.contact.pageTitle}
	description={t.contact.metaDescription}
>
	<main class="contact">
		<div class="portrait">
			<Image
				src={portrait}
				alt={t.common.portraitAlt}
				widths={[600, 900, 1200]}
				sizes="(min-width: 50em) 46vw, 100vw"
				loading="eager"
				fetchpriority="high"
			/>
		</div>

		<div class="panel">
			<div>
				<p class="eyebrow">{t.contact.eyebrow}</p>
				<h1 class="headline">{t.contact.title}</h1>
			</div>

			<p class="lead">{t.contact.lead}</p>

			<ul class="channels">
				{
					channels.map(({ label, value, href, external }) => (
						<li>
							<span class="channel-label">{label}</span>
							<a
								class="channel-value"
								href={href}
								target={external ? "_blank" : undefined}
								rel={external ? "noopener noreferrer" : undefined}
							>
								{value}
								{external && (
									<span class="sr-only"> {t.common.newWindowHint}</span>
								)}
							</a>
						</li>
					))
				}
			</ul>

			<dl class="details">
				{
					details.map(({ label, value }) => (
						<div>
							<dt class="detail-label">{label}</dt>
							<dd class="detail-value">{value}</dd>
						</div>
					))
				}
			</dl>

			<CvDownloadLink />
		</div>
	</main>
</BaseLayout>

<style>
	.contact {
		display: grid;
		grid-template-columns: 1fr;
	}

	/* El retrato va a sangre: sin bordes ni radios, la foto manda. */
	.portrait {
		position: relative;
		overflow: hidden;
		/* `.contact` es un grid de una columna (`1fr`) y el `min-width` por
		   defecto de un item de grid es `auto`, no `0`: la pista no se encoge
		   por debajo del contenido mínimo del <img>, cuyo ratio intrínseco
		   compite con el `width: 100%` de abajo. Resultado medido a 360px:
		   .portrait y .panel se salen 14px del viewport en silencio (`body`
		   lleva `overflow-x: hidden`, así que no hay barra de scroll que lo
		   delate). A ≥50em esto no hace falta: las pistas ya son
		   `minmax(0, …)`, que fija min-width en 0 por su cuenta. */
		min-width: 0;
	}

	/* En móvil el alto va atado al viewport, no a una proporción fija: con 4/5
	   el retrato se comía la pantalla y empujaba el email bajo el pliegue.
	   Antes el borde inferior se disolvía en el fondo con un mask-image (en
	   vez de cortarse en seco). Se quita: medido en Chromium, en tema claro
	   la parte del seto (verde oscuro) y la portada de la revista bajo la
	   máscara quedaban a media opacidad sobre blanco y se leían como un
	   manchurrón gris sucio — el mismo defecto reportado en el borde de
	   escritorio, solo que aquí ni siquiera hacía falta cruzar dos máscaras
	   para que apareciera. En oscuro fundía limpio con el negro. Borde
	   recto en ambos temas. */
	.portrait :global(img) {
		display: block;
		width: 100%;
		height: 38vh;
		height: 38svh;
		min-height: 16rem;
		max-height: 26rem;
		object-fit: cover;
		/* Descentrado a propósito: centrado deja un encuadre de foto de carnet. */
		object-position: 50% 22%;
	}

	.panel {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 1.25rem;
		/* Sin solape con la foto: el texto sobre una imagen a la que le queda
		   opacidad no se lee, y el eyebrow en gris apagado era ilegible. */
		padding: 0.5rem 1.5rem 3rem;
		/* Mismo motivo que en .portrait: item de grid con min-width: auto por
		   defecto. Aquí el contenido mínimo lo marcaba el titular/eyebrow, y
		   con la pasada de text-spacing (WCAG 1.4.12) el desborde llegaba a
		   61px. No es redundante con el `min-height: 0` de ≥50em: aquel evita
		   que .contact se pase del alto disponible como flex item; este evita
		   que .panel se pase del ancho disponible como grid item. */
		min-width: 0;
	}

	.eyebrow {
		font-family: var(--font-brand);
		font-size: var(--text-base);
		letter-spacing: 0.3em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.headline {
		font-family: var(--font-brand);
		font-weight: 400;
		font-size: clamp(3.5rem, 15vw, 8rem);
		line-height: 0.9;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--gray-0);
	}

	.lead {
		max-width: 34ch;
		font-size: var(--text-md);
		line-height: 1.6;
		color: var(--gray-50);
	}

	.channels {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.channels li {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	/* La etiqueta susurra; el dato es lo que se lee y se copia. */
	.channel-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.channel-value {
		align-self: flex-start;
		max-width: 100%;
		font-size: clamp(1.0625rem, 4vw, 1.375rem);
		line-height: 1.35;
		color: var(--gray-0);
		text-decoration: none;
		overflow-wrap: break-word;
		background-image: linear-gradient(
			var(--accent-regular),
			var(--accent-regular)
		);
		background-repeat: no-repeat;
		background-size: 100% 1px;
		background-position: 0 100%;
		padding-bottom: 0.15em;
		transition:
			background-size var(--theme-transition),
			color var(--theme-transition);
	}

	:global(.theme-dark) .channel-value {
		background-image: linear-gradient(
			var(--accent-dark),
			var(--accent-dark)
		);
	}

	.channel-value:hover,
	.channel-value:focus-visible {
		color: var(--link-color);
		background-size: 100% 2px;
	}

	/* Misma estructura etiqueta/valor que los canales, para que el bloque se lea
	   como algo deliberado. Lo que los separa es la jerarquía: aquí el valor va
	   a tamaño de cuerpo y sin subrayado, porque no se puede pulsar. */
	.details {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
		margin: 0;
	}

	.details div {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
	}

	.detail-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.25em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.detail-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	@media (min-width: 50em) {
		/* Llena el alto que sobra dentro de .page-shell. Antes esto era
		   `calc(100svh - 13rem)` con la altura del nav estimada a ojo, y se
		   rompía en cuanto el nav crecía (p. ej. al partirse el wordmark en dos
		   líneas): la suma se pasaba del viewport y aparecía scroll. */
		.contact {
			grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
			align-items: stretch;
			flex: 1;
			min-height: 0;
		}

		/* Izquierda y abajo sangran contra el viewport: eso no es un corte, es
		   sangrado. Arriba (nav) y a la derecha (panel) el borde es limpio, sin
		   máscara.
		   Antes había dos máscaras cruzadas (`mask-composite: intersect`) para
		   disolver esos dos bordes internos contra el fondo. En tema oscuro
		   fundía bien con el negro, pero en tema claro los píxeles oscuros del
		   retrato a media opacidad sobre blanco dejaban un halo gris sucio
		   (parecía una sombra mal hecha, no un fundido) — reportado por David
		   tras revisar en claro. Se quita: un borde recto entre foto y panel es
		   un patrón habitual en layouts de dos columnas y aquí no hace falta el
		   efecto para que se lea limpio en ningún tema. */
		.portrait :global(img) {
			position: absolute;
			inset: 0;
			height: 100%;
			min-height: 0;
			max-height: none;
		}

		.panel {
			gap: 1.75rem;
			margin-top: 0;
			padding: 3rem 3rem 3rem 4rem;
		}

		/* Acota el bloque de contenido: sin esto el texto se desparrama por más
		   de 1000px y BASE/IDIOMAS acaban en extremos opuestos, que es lo que
		   se lee como hueco vacío.
		   Nota (plan.md, coste adicional de la extracción de CvDownloadLink):
		   esta regla NO alcanza al enlace de descarga que ahora vive dentro de
		   <CvDownloadLink />, porque el ámbito de Astro va por hash de
		   componente y ese hijo lleva el suyo propio. Impacto medido en T013:
		   nulo, porque ese enlace usa `inline-flex` con `align-self: flex-start`
		   y no depende de heredar `width`/`max-width` del padre. */
		.panel > * {
			width: 100%;
			max-width: 34rem;
		}

		/* El cuerpo también escala: con el titular a 8rem, dejar el texto a 18px
		   deja un salto de jerarquía tan grande que parece diminuto. */
		.lead {
			font-size: var(--text-lg);
		}

		/* Escala con el ancho del panel: a 1,5rem fijos el email no cabía entre
		   50em y 75em y partía a mitad de palabra («gmail.c / om»). */
		.channel-value {
			font-size: clamp(1.0625rem, 1.55vw, 1.5rem);
		}

		.channel-label,
		.detail-label {
			font-size: var(--text-base);
		}

		.detail-value {
			font-size: var(--text-md);
		}

		.details {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.channel-value {
			transition: none;
		}
	}
</style>
