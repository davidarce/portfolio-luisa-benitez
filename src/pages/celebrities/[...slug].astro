---
// Redirección estática de las 9 fichas de detalle: /celebrities/<slug> →
// /celebrity-events/<slug> (rename Fase 2 §4). Misma lógica que
// src/pages/publicity/[...slug].astro: reutiliza el `getStaticPaths` de la
// colección nueva para no mantener una lista de slugs a mano.
import { getCollection } from "astro:content";
import RedirectPage from "../../components/RedirectPage.astro";

export async function getStaticPaths() {
    const celebrityEvents = await getCollection("celebrity-events");
    return celebrityEvents.map((entry) => ({
        params: { slug: entry.id },
        props: { to: `/celebrity-events/${entry.id}/`, title: entry.data.title },
    }));
}

const { to, title } = Astro.props;
---

<RedirectPage to={to} title={`${title} — Luisa Benítez`} />
