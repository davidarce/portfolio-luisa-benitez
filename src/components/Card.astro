---
import { getLocaleFromUrl } from "../i18n";
import { localizedPath } from "../i18n/routing";

interface Props {
	id: string;
	page: string;
	title: string;
	img: string;
	img_alt?: string;
	cardSize?: "normal" | "tall" | "wide";
	aspectRatio?: string;
	objectPosition?: string;
	disableLink?: boolean;
	priority?: boolean;
}

const {
	page,
	title,
	img,
	img_alt,
	cardSize,
	id,
	aspectRatio = "3 / 4",
	objectPosition = "center",
	disableLink = false,
	priority = false,
} = Astro.props;

const Tag = disableLink ? "div" : "a";

// El idioma se deduce de la URL para no tener que pasar `locale` por prop a los seis sitios donde se instancia Card.
const locale = getLocaleFromUrl(Astro.url);
const href = localizedPath(locale, `/${page}/${id}`);
---

<div
	class:list={["card", cardSize]}
	style={`--aspect-ratio: ${aspectRatio}; --object-position: ${objectPosition};`}
>
	{
		!disableLink && (
			<a href={href} class="card-link">
				<span class="sr-only">{title}</span>
			</a>
		)
	}
	<div class="title">
		<span class="text">{title}</span>
		{
			!disableLink && (
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="arrow-icon"
				>
					<line x1="7" y1="17" x2="17" y2="7" />
					<polyline points="7 7 17 7 17 17" />
				</svg>
			)
		}
	</div>
	<img
		src={img}
		alt={img_alt || ""}
		loading={priority ? "eager" : "lazy"}
		fetchpriority={priority ? "high" : undefined}
		decoding="async"
		width="400"
		height={
			400 /
			(parseFloat(aspectRatio.split("/")[0]) /
				parseFloat(aspectRatio.split("/")[1] || "1"))
		}
	/>
</div>

<style>
	.card {
		display: flex;
		flex-direction: column;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		border-radius: 0.5rem;
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-md);
		transition:
			box-shadow,
			transform var(--theme-transition);
		position: relative;
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: scale(1.02);
	}

	.title {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1rem 1.5rem;
		background: var(--gray-999);
		color: var(--gray-0);
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.text {
		flex: 1;
		text-align: center;
	}

	.arrow-icon {
		width: 1.5rem;
		height: 1.5rem;
		color: currentColor;
		margin-left: 0.5rem;
	}

	img {
		width: 100%;
		height: 100%;
		aspect-ratio: var(--aspect-ratio);
		object-fit: cover;
		object-position: var(--object-position);
	}

	@media (min-width: 50em) {
		.title {
			padding: 1.25rem 1.5rem;
			font-size: var(--text-lg);
		}
	}

	.card-link {
		position: absolute;
		inset: 0;
		z-index: 1;
	}
</style>
