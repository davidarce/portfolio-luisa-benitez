---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { getLocaleFromUrl, getTranslation, locales } from '../i18n';
import { localizedPath, stripLocale } from '../i18n/routing';

interface Props {
	/**
	 * `false` cuando la página actual no tiene contraparte real en el otro
	 * idioma (p.ej. 404.astro). Viene de BaseLayout, que ya conoce este dato
	 * porque lo usa para decidir el hreflang alternate — ver BaseLayout.astro.
	 * Por defecto `true`: la inmensa mayoría de páginas sí tienen las dos
	 * variantes y el conmutador puede apuntar a la ruta real del otro idioma.
	 */
	hasTranslation?: boolean | undefined;
}

const { hasTranslation = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = getTranslation(locale);

/** Construye una ruta interna en el idioma actual — ver src/i18n/routing.ts. */
const L = (path: string) => localizedPath(locale, path);

/**
 * Main menu items. Etiquetas por i18n (t.nav.*), no escritas a mano — ver
 * plan/02-information-architecture/REVISION-v2.md §4 para el rename de
 * "Publicidad" → "Campañas" y "Celebridades" → "Celebridades y eventos". El
 * nav va en español aunque exista traducción EN: el resto del menú comparte
 * idioma con la página actual, no se mezcla.
 *
 * Hrefs pasados por `L()` (i18n-paginas-en T008): en inglés cada uno sale
 * prefijado con `/en`; en español `L()` es la identidad, así que las URLs
 * publicadas no cambian.
 */
const textLinks: { label: string; href: string }[] = [
	{ label: t.nav.home, href: L('/') },
	{ label: t.nav.editorial, href: L('/editorials/') },
	{ label: t.nav.campaigns, href: L('/campaigns/') },
	{ label: t.nav.celebrityEvents, href: L('/celebrity-events/') },
	{ label: t.nav.films, href: L('/films/') },
	{ label: t.nav.runway, href: L('/runway/') },
	{ label: t.nav.contact, href: L('/contact/') },
];

/**
 * Ruta española canónica de la página actual, para el conmutador de idioma.
 *
 * Si la página no tiene contraparte en el otro idioma (`hasTranslation`
 * false, p.ej. 404.astro), `stripLocale` seguiría produciendo una URL que
 * Astro nunca generó — dist/404.html es el único fichero para cualquier ruta
 * no encontrada, así que no existe `dist/404/` ni `dist/en/404/`. Apuntar
 * ahí dejaría un enlace muerto justo en la página de error, que es peor que
 * el propio error. En ese caso el conmutador cae a la raíz de cada idioma
 * (`/` y `/en/`), que sí existen siempre: un visitante perdido en un 404
 * conserva una salida real hacia el sitio en su idioma.
 */
const here = hasTranslation ? stripLocale(Astro.url.pathname) : '/';

/*
 * plan-v2.md T005: "Contacto" vuelve al menú porque /contact/ vuelve a ser
 * página propia (T004). "Sobre mí" NO vuelve: sigue siendo un ancla de la
 * home (#sobre-mi), así que `t.nav.about` sigue sin usarse aquí — se
 * conserva en i18n solo como título de la página de redirección en
 * about.astro.
 */

/** Icon links to social media — sourced from src/data/profile.ts */
const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'Instagram', href: profile.instagram.url, icon: 'instagram-logo' },
];

/** Href de Home en el idioma actual — único caso que necesita comparación exacta. */
const homeHref = L('/');

/**
 * Test if a link is pointing to the current page.
 *
 * Bug corregido (i18n-paginas-en T008, ver plan Before/After §1): el guard
 * original comparaba contra el literal `'/'`. Con los hrefs ya localizados,
 * el enlace de Home en inglés es `/en/`, y `pathname.startsWith('/en/')` es
 * cierto en TODAS las páginas inglesas — "Inicio" saldría marcado como
 * página actual en todo el sitio EN. Por eso el guard compara contra
 * `homeHref` (que ya incluye el prefijo de idioma), no contra `'/'`.
 */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== homeHref && pathname.startsWith(href));
};
const activeLink = textLinks.find((link) => isCurrentPage(link.href));
---

<nav>
	<div class="menu-header">
		<div class="stack gap-1">
			<a href={homeHref} class="site-title">
				{profile.name}
				{
					activeLink && activeLink.href !== homeHref && (
						<span class="mobile-page-label">
							| {activeLink.label}
						</span>
					)
				}
			</a>
			<p class="tagline font-freehand text-lg">{profile.role}</p>
		</div>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<span class="icon-container">
						<span class="icon-hamburger">
							<Icon icon="list" />
						</span>
						<span class="icon-close">
							<Icon icon="x-mark" />
						</span>
					</span>
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a target="_blank" href={href} rel="noopener noreferrer" class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<nav class="lang-switch" aria-label={t.common.languageLabel}>
				{
					locales.map((l) => (
						<a
							href={localizedPath(l, here)}
							lang={l}
							hreflang={l}
							class="lang-link"
							aria-current={l === locale ? 'page' : null}
						>
							{l.toUpperCase()}
						</a>
					))
				}
			</nav>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<nav class="lang-switch" aria-label={t.common.languageLabel}>
				{
					locales.map((l) => (
						<a
							href={localizedPath(l, here)}
							lang={l}
							hreflang={l}
							class="lang-link"
							aria-current={l === locale ? 'page' : null}
						>
							{l.toUpperCase()}
						</a>
					))
				}
			</nav>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			// Inject menu toggle button when JS runs.
			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Hide menu (shown by default to support no-JS browsers).
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// Add "menu-content" class in JS to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			/** Set whether the menu is currently expanded or collapsed. */
			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			// Toggle menu visibility when the menu button is clicked.
			btn.addEventListener('click', () => setExpanded(menu.hidden));

			// Hide menu button for large screens.
			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			// Debe coincidir con el @media del nav en los estilos de abajo.
			const mediaQueries = window.matchMedia('(min-width: 88em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-weight: 500;
		margin-bottom: 2rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.mobile-page-label {
		font-size: var(--text-md);
		color: var(--gray-100);
		font-weight: 400;
		margin-left: 0.25rem;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0.5rem;
		font-size: 2.5rem;
		color: var(--gray-0);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		border-radius: 999rem;
		z-index: -1;
	}

	/* Icon container to maintain button size */
	.icon-container {
		position: relative;
		display: block;
		width: 1em;
		height: 1em;
	}

	/* Icon positioning with transitions */
	.icon-hamburger,
	.icon-close {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	/* Show hamburger icon by default, hide close icon */
	.icon-hamburger {
		opacity: 1;
		transform: rotate(0deg);
	}

	.icon-close {
		opacity: 0;
		transform: rotate(90deg);
		pointer-events: none;
	}

	/* When expanded, hide hamburger and show close icon */
	.menu-button[aria-expanded='true'] .icon-hamburger {
		opacity: 0;
		transform: rotate(-90deg);
		pointer-events: none;
	}

	.menu-button[aria-expanded='true'] .icon-close {
		opacity: 1;
		transform: rotate(0deg);
		pointer-events: auto;
	}

	.menu-content {
		background-color: var(--gray-999);
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-lg);
		line-height: 1.2;
		list-style: none;
		letter-spacing: 0.2em;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-0);
		font-weight: 500;
		text-decoration: none;
	}

	.link[aria-current] {
		color: var(--gray-0);
	}

	/*
	 * Cue no cromático de página actual: en móvil (el viewport dominante) el
	 * color por sí solo es indistinguible del reposo. En escritorio el peso
	 * ya distingue el enlace activo, pero esta regla vive fuera del @media
	 * para que el menú del móvil no dependa solo del color.
	 */
	.nav-items .link[aria-current='page'] {
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 0.35em;
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
		box-shadow: var(--shadow-lg);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--gray-0);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		font-weight: 800;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	/*
	 * Conmutador de idioma ES/EN (i18n-paginas-en T009, issue #41). Estilos
	 * con ámbito de este componente a propósito: Astro no los deja cruzar el
	 * límite de Nav.astro, así que viven aquí y en ningún otro sitio.
	 */
	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	.lang-link {
		display: flex;
		align-items: center;
		padding: 0.25rem 0.4375rem;
		border-radius: 999rem;
		color: var(--gray-300);
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.lang-link:hover,
	.lang-link:focus-visible {
		color: var(--gray-0);
		outline: 2px solid var(--gray-0);
		outline-offset: 2px;
	}

	.lang-link[aria-current='page'] {
		color: var(--gray-0);
		background-color: var(--gray-800);
	}

	/*
	 * 88em, no 50em: a 50em la columna central de la rejilla (que no encoge)
	 * empujaba el conmutador de tema fuera del viewport. Por debajo de 88em se
	 * usa el menú hamburguesa.
	 *
	 * Historial medido con 8 enlaces (T009 añadió "Sobre mí", ya retirado):
	 *   - 78em (1248px): `.menu-footer` se salía del viewport hasta 1300px
	 *     (+52px de desborde con 8 enlaces) → insuficiente.
	 *   - 81.25em (1300px): el punto exacto donde deja de recortar en
	 *     `/about/`, pero con margen 0 — en `/contact/` el enlace activo era
	 *     "Contacto" en vez de "Sobre mí", ~2px más ancho en Bebas Neue por el
	 *     `aria-current`, y a 1300px exactos `.menu-footer` seguía
	 *     desbordando 2px. Cero margen no sobrevive a una etiqueta distinta.
	 *   - 84em (1344px): ~44px de margen medido en el estado base sobre el
	 *     peor caso (`/contact/`), suficiente para absorber esa diferencia de
	 *     ancho entre etiquetas de `aria-current`.
	 *
	 * Home unificada (.sdd/home-unificada/plan.md T006, 6 enlaces): "Sobre mí"
	 * y "Contacto" salieron del nav (T005). Medido en home, `/campaigns/` y una
	 * ficha de detalle, el ancho natural del nav de 6 enlaces ya no requería
	 * 1344px: sin WCAG 1.4.12 dejaba de desbordar a partir de ~1105px, y con
	 * WCAG 1.4.12 forzado el peor caso subía a ~1194px. Se eligió 80em
	 * (1280px): ~86px de margen sobre ese peor caso teórico. CERRABA LA DEUDA
	 * DE #53.
	 *
	 * plan-v2.md T006 (vuelta a 7 enlaces: "Contacto" vuelve en T005, "Sobre
	 * mí" sigue sin volver). Remedido igual que arriba (rect.right de
	 * `.menu-footer` contra `window.innerWidth`, nunca `scrollWidth` — `body`
	 * lleva `overflow-x: hidden` y el desborde recorta en silencio) en las 7
	 * páginas de destino del nav (una por enlace: `/`, `/editorials/`,
	 * `/campaigns/`, `/celebrity-events/`, `/films/`, `/runway/`,
	 * `/contact/`), porque la etiqueta activa (`aria-current`, peso 800) tiene
	 * ancho distinto en cada una:
	 *   - Sin WCAG 1.4.12: no se registró ningún desborde en el rango medido
	 *     (≥1300px); el nav de 7 enlaces ya cabe muy por debajo de eso.
	 *   - Con WCAG 1.4.12 forzado (letter-spacing 0.12em, word-spacing
	 *     0.16em, line-height 1.5): el peor caso es `/celebrity-events/`
	 *     ("Celebridades y eventos", la etiqueta activa más larga), que deja
	 *     de desbordar a partir de ~1320px (82,5em) — el resto de páginas
	 *     cruza antes.
	 * 88em (1408px) deja ~88px de margen sobre ese cruce medido, no el borde
	 * exacto — lección de la pasada a 81.25em, que si se repitiera aquí
	 * (82.5em clavado) volvería a fallar en cuanto cambiara la página activa.
	 * A 88em las 7 páginas ya están en el estado estable sin desbordar
	 * (`.menu-footer` con 48px de margen real), con y sin WCAG 1.4.12.
	 * Con 7 enlaces WCAG 1.4.12 SIGUE sin desbordar en ningún ancho ≥88em:
	 * la deuda de #53 se mantiene cerrada.
	 *
	 * IMPORTANTE: este valor debe coincidir con el `matchMedia` del script.
	 */
	@media (min-width: 88em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			/* Medido: con 2.5rem el nav ocupaba 207px de alto, un 27% de un
			   viewport de 900px, y forzaba scroll en /contact. */
			padding: 1.25rem 3rem;
			gap: 1rem;
			margin-bottom: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-2xl);
		}

		.mobile-page-label {
			display: none;
		}

		.menu-content {
			display: contents;
		}

		/*
		 * Medido: con --text-xl y tracking 0.2em los 7 enlaces necesitaban
		 * 1800px de viewport y por debajo se recortaban (no se ve barra porque
		 * body lleva overflow-x: hidden). Con estos valores caben desde 64em.
		 */
		.nav-items {
			position: relative;
			flex-direction: row;
			flex-wrap: nowrap;
			font-size: var(--text-base);
			letter-spacing: 0.05em;
			font-weight: 500;
			border: 0;
			padding: 0.5rem 0.5625rem;
		}

		/* Sin partir: al hacerlo, el nav pasaba de 113 a 150px de alto y esos
		   37px extra empujaban /contact fuera del viewport. */
		.site-title {
			white-space: nowrap;
		}

		.link {
			padding: 0.5rem 0.6rem;
			border-radius: 999rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus-visible {
			color: var(--gray-0);
			outline: 2px solid var(--gray-0);
			outline-offset: 4px;
		}

		.link[aria-current='page'] {
			font-weight: 800;
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}

	/*
	 * Sin bloque que restaure --text-xl / tracking 0.2em: era justo lo que
	 * reintroducía el recorte entre 1200 y 1800px. Un solo tamaño en todo el
	 * rango de escritorio.
	 */
	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>
