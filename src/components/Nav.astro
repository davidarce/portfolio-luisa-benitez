---
import Icon from './Icon.astro';
import type { iconPaths } from './IconPaths';
import ThemeToggle from './ThemeToggle.astro';
import { profile } from '../data/profile';
import { getLocaleFromUrl, getTranslation, locales } from '../i18n';
import { localizedPath, stripLocale } from '../i18n/routing';

interface Props {
	/** `false` cuando la página actual no tiene contraparte real en el otro idioma (p.ej. 404.astro); viene de BaseLayout. */
	hasTranslation?: boolean | undefined;
}

const { hasTranslation = true } = Astro.props;
const locale = getLocaleFromUrl(Astro.url);
const t = getTranslation(locale);

const L = (path: string) => localizedPath(locale, path);

/** El nav va siempre en el idioma de la página actual, no se mezcla ES/EN. */
const textLinks: { label: string; href: string }[] = [
	{ label: t.nav.home, href: L('/') },
	{ label: t.nav.editorial, href: L('/editorials/') },
	{ label: t.nav.campaigns, href: L('/campaigns/') },
	{ label: t.nav.celebrityEvents, href: L('/celebrity-events/') },
	{ label: t.nav.films, href: L('/films/') },
	{ label: t.nav.runway, href: L('/runway/') },
	{ label: t.nav.contact, href: L('/contact/') },
];

/**
 * Si `hasTranslation` es false (p.ej. 404.astro), `stripLocale` apuntaría a
 * una URL que Astro nunca generó (no existe `dist/404/` ni `dist/en/404/`);
 * el conmutador cae a la raíz de cada idioma en ese caso.
 */
const here = hasTranslation ? stripLocale(Astro.url.pathname) : '/';

/** `t.nav.about` no se usa aquí: "Sobre mí" es un ancla de la home (#sobre-mi), no un enlace del menú. */

const iconLinks: { label: string; href: string; icon: keyof typeof iconPaths }[] = [
	{ label: 'Instagram', href: profile.instagram.url, icon: 'instagram-logo' },
];

const homeHref = L('/');

/**
 * Compara contra `homeHref` (ya localizado), no contra `'/'`: con hrefs
 * localizados el Home en inglés es `/en/`, y `pathname.startsWith('/en/')`
 * sería cierto en TODAS las páginas inglesas.
 */
const isCurrentPage = (href: string) => {
	let pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '');
	if (pathname.at(0) !== '/') pathname = '/' + pathname;
	if (pathname.at(-1) !== '/') pathname += '/';
	return pathname === href || (href !== homeHref && pathname.startsWith(href));
};
const activeLink = textLinks.find((link) => isCurrentPage(link.href));
---

<nav>
	<div class="menu-header">
		<div class="stack gap-1">
			<a href={homeHref} class="site-title">
				{profile.name}
				{
					activeLink && activeLink.href !== homeHref && (
						<span class="mobile-page-label">
							| {activeLink.label}
						</span>
					)
				}
			</a>
			<p class="tagline font-freehand text-lg">{profile.role}</p>
		</div>
		<menu-button>
			<template>
				<button class="menu-button" aria-expanded="false">
					<span class="sr-only">Menu</span>
					<span class="icon-container">
						<span class="icon-hamburger">
							<Icon icon="list" />
						</span>
						<span class="icon-close">
							<Icon icon="x-mark" />
						</span>
					</span>
				</button>
			</template>
		</menu-button>
	</div>
	<noscript>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</noscript>
	<noscript>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a target="_blank" href={href} rel="noopener noreferrer" class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>
			<nav class="lang-switch" aria-label={t.common.languageLabel}>
				{
					locales.map((l) => (
						<a
							href={localizedPath(l, here)}
							lang={l}
							hreflang={l}
							class="lang-link"
							aria-current={l === locale ? 'page' : null}
							data-astro-reload
						>
							{l.toUpperCase()}
						</a>
					))
				}
			</nav>
		</div>
	</noscript>
	<div id="menu-content" hidden>
		<ul class="nav-items">
			{
				textLinks.map(({ label, href }) => (
					<li>
						<a aria-current={isCurrentPage(href) ? 'page' : null} class="link" href={href}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="menu-footer">
			<div class="socials">
				{
					iconLinks.map(({ href, icon, label }) => (
						<a href={href} class="social">
							<span class="sr-only">{label}</span>
							<Icon icon={icon} />
						</a>
					))
				}
			</div>

			<nav class="lang-switch" aria-label={t.common.languageLabel}>
				{
					locales.map((l) => (
						<a
							href={localizedPath(l, here)}
							lang={l}
							hreflang={l}
							class="lang-link"
							aria-current={l === locale ? 'page' : null}
							data-astro-reload
						>
							{l.toUpperCase()}
						</a>
					))
				}
			</nav>

			<div class="theme-toggle">
				<ThemeToggle />
			</div>
		</div>
	</div>
</nav>

<script>
	class MenuButton extends HTMLElement {
		constructor() {
			super();

			this.appendChild(this.querySelector('template')!.content.cloneNode(true));
			const btn = this.querySelector('button')!;

			// Menu shown by default to support no-JS browsers; hidden here once JS takes over.
			const menu = document.getElementById('menu-content')!;
			menu.hidden = true;
			// "menu-content" class added only in JS, to avoid covering content in non-JS browsers.
			menu.classList.add('menu-content');

			const setExpanded = (expand: boolean) => {
				btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
				menu.hidden = !expand;
			};

			btn.addEventListener('click', () => setExpanded(menu.hidden));

			const handleViewports = (e: MediaQueryList | MediaQueryListEvent) => {
				setExpanded(e.matches);
				btn.hidden = e.matches;
			};
			// Debe coincidir con el @media del nav en los estilos de abajo.
			const mediaQueries = window.matchMedia('(min-width: 88em)');
			handleViewports(mediaQueries);
			mediaQueries.addEventListener('change', handleViewports);
		}
	}
	customElements.define('menu-button', MenuButton);
</script>

<style>
	nav {
		z-index: 9999;
		position: relative;
		font-weight: 500;
		margin-bottom: 2rem;
	}

	.menu-header {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 1.5rem;
	}

	.site-title {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		line-height: 1.1;
		color: var(--gray-0);
		text-decoration: none;
		font-size: var(--text-xl);
		font-weight: 500;
		letter-spacing: 0.05em;
	}

	.mobile-page-label {
		font-size: var(--text-md);
		color: var(--gray-100);
		font-weight: 400;
		margin-left: 0.25rem;
	}

	.menu-button {
		position: relative;
		display: flex;
		border: 0;
		border-radius: 999rem;
		padding: 0.5rem;
		font-size: 2.5rem;
		color: var(--gray-0);
	}

	.menu-button[aria-expanded='true'] {
		color: var(--gray-0);
	}

	.menu-button[hidden] {
		display: none;
	}

	.menu-button::before {
		position: absolute;
		inset: -1px;
		content: '';
		border-radius: 999rem;
		z-index: -1;
	}

	.icon-container {
		position: relative;
		display: block;
		width: 1em;
		height: 1em;
	}

	.icon-hamburger,
	.icon-close {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	.icon-hamburger {
		opacity: 1;
		transform: rotate(0deg);
	}

	.icon-close {
		opacity: 0;
		transform: rotate(90deg);
		pointer-events: none;
	}

	.menu-button[aria-expanded='true'] .icon-hamburger {
		opacity: 0;
		transform: rotate(-90deg);
		pointer-events: none;
	}

	.menu-button[aria-expanded='true'] .icon-close {
		opacity: 1;
		transform: rotate(0deg);
		pointer-events: auto;
	}

	.menu-content {
		background-color: var(--gray-999);
		position: absolute;
		left: 0;
		right: 0;
	}

	.nav-items {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1rem;
		font-size: var(--text-lg);
		line-height: 1.2;
		list-style: none;
		letter-spacing: 0.2em;
		padding: 2rem;
		background-color: var(--gray-999);
		border-bottom: 1px solid var(--gray-800);
	}

	.link {
		display: inline-block;
		color: var(--gray-0);
		font-weight: 500;
		text-decoration: none;
	}

	.link[aria-current] {
		color: var(--gray-0);
	}

	/* Cue no cromático: en móvil el color solo es indistinguible del reposo, por eso vive fuera del @media. */
	.nav-items .link[aria-current='page'] {
		font-weight: 800;
		text-decoration: underline;
		text-underline-offset: 0.35em;
	}

	.menu-footer {
		--icon-size: var(--text-xl);
		--icon-padding: 0.5rem;

		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 1.5rem 2rem 1.5rem 1.5rem;
		background-color: var(--gray-999);
		border-radius: 0 0 0.75rem 0.75rem;
		box-shadow: var(--shadow-lg);
	}

	.socials {
		display: flex;
		flex-wrap: wrap;
		gap: 0.625rem;
		font-size: var(--icon-size);
	}

	.social {
		display: flex;
		padding: var(--icon-padding);
		text-decoration: none;
		color: var(--gray-0);
		transition: color var(--theme-transition);
	}

	.social:hover,
	.social:focus {
		font-weight: 800;
	}

	.theme-toggle {
		display: flex;
		align-items: center;
		height: calc(var(--icon-size) + 2 * var(--icon-padding));
	}

	/* Astro no deja los estilos con scope cruzar el límite del componente: viven solo aquí. */
	.lang-switch {
		display: flex;
		align-items: center;
		gap: 0.375rem;
		font-size: var(--text-sm);
		font-weight: 600;
		letter-spacing: 0.05em;
	}

	.lang-link {
		display: flex;
		align-items: center;
		padding: 0.25rem 0.4375rem;
		border-radius: 999rem;
		color: var(--gray-300);
		text-decoration: none;
		transition:
			color var(--theme-transition),
			background-color var(--theme-transition);
	}

	.lang-link:hover,
	.lang-link:focus-visible {
		color: var(--gray-0);
		outline: 2px solid var(--gray-0);
		outline-offset: 2px;
	}

	.lang-link[aria-current='page'] {
		color: var(--gray-0);
		background-color: var(--gray-800);
	}

	/*
	 * 88em, no 50em: por debajo, la columna central de la rejilla empuja el
	 * conmutador de tema fuera del viewport.
	 *
	 * El valor exacto viene de medir el peor caso (`/celebrity-events/`, la
	 * etiqueta activa más ancha) con WCAG 1.4.12 forzado, con margen real —
	 * clavar el breakpoint justo en el punto de cruce medido (probado a
	 * 81.25em) no sobrevive a que cambie la página activa o la etiqueta.
	 *
	 * IMPORTANTE: este valor debe coincidir con el `matchMedia` del script.
	 */
	@media (min-width: 88em) {
		nav {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
			/* Medido: con 2.5rem el nav forzaba scroll en /contact (207px de alto). */
			padding: 1.25rem 3rem;
			gap: 1rem;
			margin-bottom: 1rem;
		}

		.menu-header {
			padding: 0;
		}

		.site-title {
			font-size: var(--text-2xl);
		}

		.mobile-page-label {
			display: none;
		}

		.menu-content {
			display: contents;
		}

		/* Medido: con --text-xl y tracking 0.2em los 7 enlaces se recortaban por debajo de 1800px. */
		.nav-items {
			position: relative;
			flex-direction: row;
			flex-wrap: nowrap;
			font-size: var(--text-base);
			letter-spacing: 0.05em;
			font-weight: 500;
			border: 0;
			padding: 0.5rem 0.5625rem;
		}

		/* Sin partir: al hacerlo, el nav pasaba de 113 a 150px de alto y /contact salía del viewport. */
		.site-title {
			white-space: nowrap;
		}

		.link {
			padding: 0.5rem 0.6rem;
			border-radius: 999rem;
			transition:
				color var(--theme-transition),
				background-color var(--theme-transition);
		}

		.link:hover,
		.link:focus-visible {
			color: var(--gray-0);
			outline: 2px solid var(--gray-0);
			outline-offset: 4px;
		}

		.link[aria-current='page'] {
			font-weight: 800;
		}

		.menu-footer {
			--icon-padding: 0.375rem;

			justify-self: flex-end;
			align-items: center;
			padding: 0;
			background-color: transparent;
			box-shadow: none;
		}

		.socials {
			display: none;
		}
	}

	@media (min-width: 60em) {
		.socials {
			display: flex;
			justify-content: flex-end;
			gap: 0;
		}
	}

	/* Sin bloque que restaure --text-xl / tracking 0.2em: reintroducía el recorte entre 1200 y 1800px. */
	@media (forced-colors: active) {
		.link[aria-current='page'] {
			color: SelectedItem;
		}
	}
</style>
