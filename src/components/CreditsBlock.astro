---
/**
 * Regla innegociable: el rol de Luisa se pinta SIEMPRE, y si existe
 * `leadStylist` también. No hay caso en que se omita.
 */
import { getLocaleFromUrl, getTranslation } from "../i18n";
import { profile } from "../data/profile";

interface Credits {
	photographer?: string;
	director?: string;
	muah?: string;
	talent?: string;
	talentAgency?: string;
	artDirection?: string;
	production?: string;
	location?: string;
}

interface Props {
	role: "lead-stylist" | "assistant-stylist" | "wardrobe-assistant" | "co-stylist";
	roleDetail?: string;
	leadStylist?: string;
	year?: number;
	client?: string;
	publication?: string;
	format?:
		| "editorial"
		| "campaign"
		| "social"
		| "runway"
		| "event"
		| "film"
		| "model-test";
	credits?: Credits;
}

const { role, roleDetail, leadStylist, year, client, publication, format, credits } =
	Astro.props;

const t = getTranslation(getLocaleFromUrl(Astro.url));
const c = t.credits;

const roleLabel = c.role[role];
const formatLabel = format === "model-test" ? c.format["model-test"] : undefined;

// El estilismo se lee de arriba abajo: primero quien lo firma, después quien
// asiste. Cuando Luisa firma no hay `leadStylist` y queda una sola línea.
const stylistRows = [
	...(leadStylist ? [{ label: c.role["lead-stylist"], value: leadStylist }] : []),
	{ label: roleLabel, value: profile.name },
];

const contextLine = [publication, client, year ? String(year) : undefined]
	.filter((part): part is string => Boolean(part))
	.join(" · ");

const creditOrder: (keyof Credits)[] = [
	"photographer",
	"director",
	"muah",
	"talent",
	"talentAgency",
	"artDirection",
	"production",
	"location",
];

const creditRows = creditOrder
	.map((key) => ({ key, label: c.labels[key], value: credits?.[key] }))
	.filter(
		(row): row is { key: keyof Credits; label: string; value: string } =>
			Boolean(row.value),
	);
---

<section class="credits-block" aria-label={roleLabel}>
	{
		stylistRows.map(({ label, value }) => (
			<p class="stylist-line">
				<span class="stylist-label">{label}:</span> {value}
			</p>
		))
	}

	{roleDetail && <p class="role-detail">{roleDetail}</p>}
	{formatLabel && <p class="format-tag">{formatLabel}</p>}

	{contextLine && <p class="context-line">{contextLine}</p>}

	{
		creditRows.length > 0 && (
			<dl class="credits-list">
				{creditRows.map(({ key, label, value }) => (
					<div class="credit-row">
						<dt class="credit-label">{label}</dt>
						<dd class="credit-value">{value}</dd>
					</div>
				))}
			</dl>
		)
	}
</section>

<style>
	.credits-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
	}

	.stylist-line {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.stylist-label {
		font-family: var(--font-brand);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.role-detail {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.format-tag {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.context-line {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.credits-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
		margin: 0.5rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--gray-800);
	}

	.credit-row {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		margin: 0;
	}

	.credit-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.credit-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	@media (min-width: 50em) {
		.credits-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
