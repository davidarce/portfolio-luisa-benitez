---
/**
 * Regla innegociable: el rol de Luisa se pinta SIEMPRE, y si existe
 * `leadStylist` también. No hay caso en que se omita.
 */
import { getLocaleFromUrl, getTranslation } from "../i18n";
import { profile } from "../data/profile";

interface Credits {
	photographer?: string;
	director?: string;
	muah?: string;
	makeup?: string;
	hair?: string;
	setDesign?: string;
	stylingTeam?: string;
	video?: string;
	talent?: string;
	talentAgency?: string;
	artDirection?: string;
	production?: string;
	location?: string;
}

interface Props {
	role:
		| "lead-stylist"
		| "assistant-stylist"
		| "wardrobe-assistant"
		| "wardrobe-aux"
		| "co-stylist";
	roleDetail?: string;
	leadStylist?: string;
	year?: number;
	client?: string;
	publication?: string;
	format?:
		| "editorial"
		| "campaign"
		| "social"
		| "runway"
		| "event"
		| "film"
		| "model-test";
	credits?: Credits;
	/**
	 * La atribución va arriba, junto al título, porque es lo que declara el rol
	 * de Luisa y no puede quedar escondida. El equipo va al final: medido, el
	 * bloque entero ocupaba el 79% de la pantalla en móvil y empujaba la primera
	 * foto a 1,5 pantallas de scroll, en una página cuyo contenido son las fotos.
	 */
	parte?: "atribucion" | "equipo";
}

const {
	role,
	roleDetail,
	leadStylist,
	year,
	client,
	publication,
	format,
	credits,
	parte = "atribucion",
} = Astro.props;

const t = getTranslation(getLocaleFromUrl(Astro.url));
const c = t.credits;

const roleLabel = c.role[role];
const formatLabel = format === "model-test" ? c.format["model-test"] : undefined;

// El estilismo se lee de arriba abajo: primero quien lo firma, después quien
// asiste. Cuando Luisa firma no hay `leadStylist` y queda una sola línea.
const stylistRows = [
	...(leadStylist ? [{ label: c.role["lead-stylist"], value: leadStylist }] : []),
	{ label: roleLabel, value: profile.name },
];

const contextLine = [publication, client, year ? String(year) : undefined]
	.filter((part): part is string => Boolean(part))
	.join(" · ");

const creditOrder: (keyof Credits)[] = [
	"photographer",
	"director",
	"video",
	"artDirection",
	"setDesign",
	"stylingTeam",
	"muah",
	"makeup",
	"hair",
	"talent",
	"talentAgency",
	"production",
	"location",
];

/**
 * Los créditos se escriben «Nombre @alias», que es como se acredita en moda.
 * Aquí el alias se parte del texto para enlazarlo a Instagram: la gente del
 * sector busca a sus compañeros por ahí, y un crédito sin enlace obliga a
 * copiar el nombre a mano.
 */
const PATRON_ALIAS = /(@[A-Za-z0-9._]+)/g;

function partirPorAlias(valor: string) {
	return valor
		.split(PATRON_ALIAS)
		.filter(Boolean)
		.map((parte) => (parte.startsWith("@") ? { alias: parte } : { texto: parte }));
}

const creditRows = creditOrder
	.map((key) => ({ key, label: c.labels[key], value: credits?.[key] }))
	.filter(
		(row): row is { key: keyof Credits; label: string; value: string } =>
			Boolean(row.value),
	);
---

<section class:list={["credits-block", parte]} aria-label={parte === "equipo" ? c.heading : roleLabel}>
	{
		parte === "atribucion" && (
			<>
				{stylistRows.map(({ label, value }) => (
					<p class="stylist-line">
						<span class="stylist-label">{label}:</span> {value}
					</p>
				))}
				{roleDetail && <p class="role-detail">{roleDetail}</p>}
				{formatLabel && <p class="format-tag">{formatLabel}</p>}
				{contextLine && <p class="context-line">{contextLine}</p>}
			</>
		)
	}

	{
		parte === "equipo" && creditRows.length > 0 && (
			<>
				<h2 class="team-heading">{c.heading}</h2>
				<dl class="credits-list">
					{creditRows.map(({ key, label, value }) => (
						<div class="credit-row">
							<dt class="credit-label">{label}</dt>
							<dd class="credit-value">
								{partirPorAlias(value).map((parte) =>
									parte.alias ? (
										<a
											class="alias"
											href={`https://www.instagram.com/${parte.alias.slice(1)}/`}
											target="_blank"
											rel="noopener noreferrer"
											aria-label={`${parte.alias} ${c.onInstagram} ${t.common.newWindowHint}`}
										>
											{parte.alias}
										</a>
									) : (
										parte.texto
									),
								)}
							</dd>
						</div>
					))}
				</dl>
			</>
		)
	}
</section>

<style>
	.credits-block {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	/* Arriba no lleva recuadro: son dos líneas y el marco pesaba más que ellas. */
	.credits-block.equipo {
		padding: 1.5rem;
		border: 1px solid var(--gray-800);
		border-radius: 1rem;
	}

	.team-heading {
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gray-100);
		margin: 0;
	}

	.stylist-line {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.stylist-label {
		font-family: var(--font-brand);
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.role-detail {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.format-tag {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.context-line {
		font-size: var(--text-base);
		color: var(--gray-50);
	}

	.credits-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem 2rem;
		margin: 0.5rem 0 0;
	}

	.credit-row {
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		min-width: 0;
		margin: 0;
	}

	.credit-label {
		font-family: var(--font-brand);
		font-size: var(--text-sm);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--gray-100);
	}

	.alias {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: var(--gray-600);
		text-underline-offset: 0.2em;
		transition: color var(--theme-transition);
	}

	.alias:hover,
	.alias:focus-visible {
		color: var(--accent-regular);
		text-decoration-color: currentColor;
	}

	.credit-value {
		margin: 0;
		font-size: var(--text-base);
		line-height: 1.4;
		color: var(--gray-50);
	}

	@media (min-width: 50em) {
		.credits-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
